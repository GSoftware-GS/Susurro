# Cabeceras de seguridad para Netlify (equivalente al .htaccess de Apache).
#
# La CSP de esta cabecera se suma a la de index.html (se aplican las dos) y además limita los
# scripts a las rutas exactas de la app. Así no se ejecuta el script que Netlify inyecta en las
# páginas (/.netlify/scripts/hud), que tendría acceso a los datos de la app.
# IMPORTANTE: si cambias el nombre del sitio o usas un dominio propio, cambia aquí el dominio;
# si no, la app no cargará.
/*
  Content-Security-Policy: default-src 'none'; script-src https://susurro-chat.netlify.app/app.js https://susurro-chat.netlify.app/vendor/ 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' wss: ws://*.onion:* http://2gzyxa5ihm7nsggfxnu52rck2vv4rvmdlkiu3zzui5du4xyclen53wid.onion https://2gzyxa5ihm7nsggfxnu52rck2vv4rvmdlkiu3zzui5du4xyclen53wid.onion http://duckduckgogg42xjoc72x3sjasowoarfbgcmvfimaftt6twagswzczad.onion https://duckduckgogg42xjoc72x3sjasowoarfbgcmvfimaftt6twagswzczad.onion; manifest-src 'self'; media-src 'self' blob: mediastream:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types susurro
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), display-capture=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

# El service worker y la página deben comprobarse siempre para detectar versiones nuevas.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
